# Copy this file to `.env` and fill in your Supabase project values.
# Never commit real secrets (`.env` is gitignored).
#
# Development:
#   flutter run --dart-define-from-file=.env
#
# Release / private testing (Supabase keys only — do not include DX_*):
#   flutter build apk --release --dart-define-from-file=.env.release
#   or pass SUPABASE_URL and SUPABASE_ANON_KEY with --dart-define
#
# See BUILD.md.

# Public web origin (no trailing slash). Used for:
#   - WhatsApp/SMS / View invoice document links (always public — never localhost)
#   - Auth email redirects in *release* web builds (signup / recovery / invites)
# Debug/profile web keeps the current page origin for Auth only.
# Customer document links fall back to https://sello.cashro.pro when unset so
# phones can open /d/<token>. Set this in local `.env` for dart-define-from-file:
# SELLO_PUBLIC_URL=https://sello.cashro.pro
# Vercel defaults to https://sello.cashro.pro when unset.
# Required for iOS/Android so customers can open /d/<token> in a browser.
# SELLO_PUBLIC_URL=https://sello.cashro.pro
#
# Optional override for the public Sello release JSON (version check).
# Defaults to SELLO_PUBLIC_URL/sello-release.json, or /sello-release.json on web.
# SELLO_RELEASE_MANIFEST_URL=https://app.sello.example/sello-release.json
#
# Which mobile binary this build is. Required for Android APKs so each app
# reads its own latest/minimum/destination. Omitted in `flutter run` — then
# the signed-in role maps Sales Rep vs Owner/Manager.
# SELLO_RELEASE_APP=sales_rep
# SELLO_RELEASE_APP=owner_manager

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Text.lk SMS: do NOT put TEXTLK_API_TOKEN here. It is a Supabase Edge Function
# secret only (Dashboard → Edge Functions → Secrets, or
# `npx supabase secrets set TEXTLK_API_TOKEN=...`). The Flutter app never
# calls Text.lk directly.
#
# Team login invites use Edge Function `invite-employee-login` with the
# project service-role key (auto-provided in hosted Supabase). Deploy with:
#   npx supabase functions deploy invite-employee-login --no-verify-jwt
# Apply migration 058 before deploying. JWT is still checked inside the
# function; --no-verify-jwt is required so browser CORS preflight succeeds.

# Alias accepted by the app if SUPABASE_ANON_KEY is omitted:
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# Developer Experience (local debug / profile builds only)
# These accounts are used through the normal Supabase auth flow.
# Keep real values only in `.env`, never in source control.
# Do not pass DX_* keys into release builds, Vercel, or any production host.
# Production does not read or require these variables.
# ---------------------------------------------------------------------------

DX_AUTO_LOGIN=false
DX_DEFAULT_USER=owner

DX_OWNER_EMAIL=owner@unitech.demo
DX_OWNER_PASSWORD=change-me

DX_MANAGER_EMAIL=manager@unitech.demo
DX_MANAGER_PASSWORD=change-me

DX_SALES_EMAIL=sales@unitech.demo
DX_SALES_PASSWORD=change-me
